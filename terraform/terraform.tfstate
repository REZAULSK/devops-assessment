      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "arn": "arn:aws:ecs:us-east-1:045861053872:task-definition/hero-api-assessment:1",
            "arn_without_revision": "arn:aws:ecs:us-east-1:045861053872:task-definition/hero-api-assessment",
            "container_definitions": "[{\"dependsOn\":[{\"condition\":\"START\",\"containerName\":\"aws-otel-collector\"}],\"environment\":[{\"name\":\"DEBUG\",\"value\":\"false\"},{\"name\":\"ENVIRONMENT\",\"value\":\"assessment\"},{\"name\":\"LOG_LEVEL\",\"value\":\"INFO\"},{\"name\":\"OTEL_EXPORTER_OTLP_ENDPOINT\",\"value\":\"http://127.0.0.1:4317\"},{\"name\":\"OTEL_SERVICE_NAME\",\"value\":\"hero-api-assessment\"}],\"essential\":true,\"image\":\"045861053872.dkr.ecr.us-east-1.amazonaws.com/hero-api-assessment:bootstrap\",\"logConfiguration\":{\"logDriver\":\"awslogs\",\"options\":{\"awslogs-region\":\"us-east-1\",\"awslogs-stream-prefix\":\"api\",\"awslogs-group\":\"/ecs/hero-api-assessment\"}},\"mountPoints\":[],\"name\":\"api\",\"portMappings\":[{\"containerPort\":8000,\"hostPort\":8000,\"protocol\":\"tcp\"}],\"secrets\":[{\"name\":\"DATABASE_URL\",\"valueFrom\":\"arn:aws:secretsmanager:us-east-1:045861053872:secret:hero-api-assessment/database-url-cFcJxq\"}],\"systemControls\":[],\"volumesFrom\":[]},{\"environment\":[{\"name\":\"AOT_CONFIG_CONTENT\",\"value\":\"# ADOT Collector configuration for the Fargate sidecar.\\n#\\n# Delivered to the container through the AOT_CONFIG_CONTENT environment\\n# variable, which Terraform populates from this file. Keeping it as a real file\\n# rather than an inline heredoc means it is reviewable, diffable, and can be\\n# validated by the collector's own `validate` subcommand.\\n\\nreceivers:\\n    otlp:\\n        protocols:\\n            grpc:\\n                # Loopback only. The collector shares a network namespace with\\n                # the application container inside the task, so nothing outside\\n                # the task can reach this port.\\n                endpoint: 127.0.0.1:4317\\n\\nprocessors:\\n    batch/traces:\\n        timeout: 1s\\n        send_batch_size: 50\\n\\n    # Drops spans the moment memory pressure appears, rather than letting the\\n    # collector be OOM-killed and take the whole task down with it.\\n    memory_limiter:\\n        check_interval: 1s\\n        limit_percentage: 75\\n        spike_limit_percentage: 15\\n\\nexporters:\\n    awsxray:\\n        region: ${env:AWS_REGION}\\n        # Attributes listed here become searchable filters in the X-Ray console.\\n        # Anything not indexed is still stored, just not filterable.\\n        indexed_attributes:\\n            - http.route\\n            - http.status_code\\n            - deployment.environment\\n\\nservice:\\n    pipelines:\\n        traces:\\n            receivers: [otlp]\\n            processors: [memory_limiter, batch/traces]\\n            exporters: [awsxray]\\n    telemetry:\\n        logs:\\n            level: info\\n\"},{\"name\":\"AWS_REGION\",\"value\":\"us-east-1\"}],\"essential\":true,\"image\":\"public.ecr.aws/aws-observability/aws-otel-collector:latest\",\"logConfiguration\":{\"logDriver\":\"awslogs\",\"options\":{\"awslogs-group\":\"/ecs/hero-api-assessment\",\"awslogs-region\":\"us-east-1\",\"awslogs-stream-prefix\":\"otel\"}},\"mountPoints\":[],\"name\":\"aws-otel-collector\",\"portMappings\":[],\"systemControls\":[],\"volumesFrom\":[]}]",
            "cpu": "512",
