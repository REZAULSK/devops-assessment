# Local development only. On AWS, DATABASE_URL arrives from Secrets Manager and
# the OTEL_* values are set in the task definition.
#
# Copy to .env — which is gitignored and dockerignored — before running the app
# outside Compose. Compose sets all of this itself and needs no .env file.

DATABASE_URL=postgresql+psycopg://hero:hero_local_only@localhost:5433/heroes
DEBUG=False
LOG_LEVEL=INFO

# Environment label; appears on spans as deployment.environment.
ENVIRONMENT=local

# Service name shown in X-Ray and Jaeger.
OTEL_SERVICE_NAME=devops-assessment-api

# Where to export spans. Leave unset to keep instrumentation on while exporting
# nothing — useful when running the app without a collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Set to true to switch tracing off entirely.
OTEL_SDK_DISABLED=false
